%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3b4c5d6e7f809102132435465768798a, type: 3}
  m_Name: NamePool
  m_EditorClassIdentifier: 
  entries:
  - displayName: '狌狌'
    pinyin: 'xīng xīng'
    category: '兽'
    oneLiner: '状如猿猴、白耳，能匍匐又能直立行走，传说通晓往事，食之可善跑'
  - displayName: '鹿蜀'
    pinyin: 'lù shǔ'
    category: '兽'
    oneLiner: '外形似马，白头、虎纹、红尾，鸣声如同歌谣，佩戴它的皮毛利于子孙兴旺'
  - displayName: '猼訑'
    pinyin: 'bó yí'
    category: '兽'
    oneLiner: '像羊却长着九条尾、四只耳，眼睛生在背上，披上它的皮毛可使人不畏惧'
  - displayName: '䍺'
    pinyin: 'huán'
    category: '兽'
    oneLiner: '形似羊，没有嘴巴，天生不会死亡'
  - displayName: '九尾狐'
    pinyin: 'jiǔ wěi hú'
    category: '兽'
    oneLiner: '生有九条尾巴，声如婴儿啼哭，上古记载中既为瑞兽也有食人之说'
  - displayName: '蛊雕'
    pinyin: 'gǔ diāo'
    category: '鸟'
    oneLiner: '样貌像雕鸟，头上生角，叫声酷似婴儿啼哭，是会吃人的凶兽'
  - displayName: '凤凰'
    pinyin: 'fèng huáng'
    category: '鸟'
    oneLiner: '五彩神鸟，身载德、义、礼、仁、信五纹，自歌自舞，现世则天下安宁'
  - displayName: '狰'
    pinyin: 'zhēng'
    category: '兽'
    oneLiner: '身形如豹，单头五尾，长有一只独角，叫声如敲击石头'
  - displayName: '毕方'
    pinyin: 'bì fāng'
    category: '鸟'
    oneLiner: '独足神鸟，外形像鹤，青身白喙，是预示大火降临的灾异之鸟'
  - displayName: '天狗'
    pinyin: 'tiān gǒu'
    category: '兽'
    oneLiner: '样貌像狸猫，头部白色，叫声如同榴榴，能抵御凶邪'
  - displayName: '穷奇'
    pinyin: 'qióng qí'
    category: '兽'
    oneLiner: '状如猛虎、生有双翼，喜挑拨是非，是好恶颠倒的上古凶神'
  - displayName: '英招'
    pinyin: 'yīng zhāo'
    category: '神'
    oneLiner: '马身人面，虎纹鸟翼，主管天帝的悬圃，巡行四海'
  - displayName: '陆吾'
    pinyin: 'lù wú'
    category: '神'
    oneLiner: '虎身九尾、人面虎爪，是昆仑神山的守护神，掌管天帝苑囿'
  - displayName: '钦原'
    pinyin: 'qīn yuán'
    category: '鸟'
    oneLiner: '外形像蜂，大小如同鸳鸯，蜇到鸟兽即死、蜇到树木便枯'
  - displayName: '帝江'
    pinyin: 'dì jiāng'
    category: '神'
    oneLiner: '没有耳目口鼻，混沌无面，六足四翼，通晓歌舞，也就是混沌'
  - displayName: '土蝼'
    pinyin: 'tǔ lóu'
    category: '兽'
    oneLiner: '外形像羊，长着四只角，性情凶猛，会食人'
  - displayName: '饕餮'
    pinyin: 'tāo tiè'
    category: '兽'
    oneLiner: '羊身人面，眼在腋下，虎齿人手，贪食无度，是贪馋的凶兽'
  - displayName: '獓狠'
    pinyin: 'áo yē'
    category: '兽'
    oneLiner: '身形如牛，周身长着刺猬般的硬毛，头上四角，是凶恶食人异兽'
  - displayName: '朏朏'
    pinyin: 'fěi fěi'
    category: '兽'
    oneLiner: '像猫，长着白尾、鬣毛，饲养它可以消解忧愁'
  - displayName: '蠪侄'
    pinyin: 'lóng zhí'
    category: '兽'
    oneLiner: '状如狐狸，九尾九首，虎爪，叫声如同婴儿，会食人'
  - displayName: '合窳'
    pinyin: 'hé yǔ'
    category: '兽'
    oneLiner: '外形像猪，人面黄身，叫声如婴儿，食人，出现就会大水泛滥'
  - displayName: '夔'
    pinyin: 'kuí'
    category: '兽'
    oneLiner: '苍身无角，独足神牛'
  - displayName: '何罗鱼'
    pinyin: 'hé luó yú'
    category: '鱼'
    oneLiner: '传说食用它可以治疗痈肿'
  - displayName: '鮨鱼'
    pinyin: 'yì yú'
    category: '鱼'
    oneLiner: '鱼身而犬首，叫声如同婴儿'
  - displayName: '肥遗'
    pinyin: 'féi yí'
    category: '蛇'
    oneLiner: '一首两身的毒蛇，见则天下大旱'
  - displayName: '颙'
    pinyin: 'yóng'
    category: '鸟'
    oneLiner: '像猫头鹰，人面四目有耳'
  - displayName: '当康'
    pinyin: 'dāng kāng'
    category: '兽'
    oneLiner: '丰收祥瑞之兽'
  - displayName: '峳峳'
    pinyin: 'yóu yóu'
    category: '兽'
    oneLiner: '像马，羊目、四角、牛尾，叫声如同狗叫'
  - displayName: '蜚'
    pinyin: 'fěi'
    category: '兽'
    oneLiner: '行经之处草木枯死、生水即败，是大灾之兽'
  - displayName: '窫窳'
    pinyin: 'yà yǔ'
    category: '兽'
    oneLiner: '食人凶兽'
  - displayName: '巴蛇'
    pinyin: 'bā shé'
    category: '蛇'
    oneLiner: '巨蟒，青黄红黑杂色'
  - displayName: '旄马'
    pinyin: 'máo mǎ'
    category: '兽'
    oneLiner: '生于西北荒远之地'
  - displayName: '开明兽'
    pinyin: 'kāi míng shòu'
    category: '神'
    oneLiner: '身似虎，九个头颅都长着人脸'
  - displayName: '视肉'
    pinyin: 'shì ròu'
    category: '兽'
    oneLiner: '割取之后能自行复生，取之不尽'
  - displayName: '吉量'
    pinyin: 'jí liáng'
    category: '兽'
    oneLiner: '骑乘它可长寿千岁'
  - displayName: '蜪犬'
    pinyin: 'táo quǎn'
    category: '兽'
    oneLiner: '叫声如同呻吟'
  - displayName: '驺吾'
    pinyin: 'zōu wú'
    category: '兽'
    oneLiner: '仁兽，不食活物'
  - displayName: '阘非'
    pinyin: 'tà fēi'
    category: '兽'
    oneLiner: '人面兽身，青色'
  - displayName: '环狗'
    pinyin: 'huán gǒu'
    category: '兽'
    oneLiner: '狗首人身，浑身黄色'
  - displayName: '陵鱼'
    pinyin: 'líng yú'
    category: '鱼'
    oneLiner: '人面鱼身，有手足'
  - displayName: '三青鸟'
    pinyin: 'sān qīng niǎo'
    category: '鸟'
    oneLiner: '西王母传递信使的神鸟'
  - displayName: '双双'
    pinyin: 'shuāng shuāng'
    category: '兽'
    oneLiner: '三身一体的奇兽，同头共躯，相伴共生'
  - displayName: '相柳'
    pinyin: 'xiāng liǔ'
    category: '蛇'
    oneLiner: '所到之处化为沼泽，喷吐毒液'
  - displayName: '天吴'
    pinyin: 'tiān wú'
    category: '神'
    oneLiner: '水伯，八首人面、八足八尾，青黄纹理'
  - displayName: '计蒙'
    pinyin: 'jì méng'
    category: '神'
    oneLiner: '人身龙首，居于漳渊'
  - displayName: '应龙'
    pinyin: 'yìng lóng'
    category: '神'
    oneLiner: '主司雨水，见则甘霖将至'
